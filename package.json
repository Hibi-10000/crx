{
  "author": "Hibi_10000",
  "name": "@hibi_10000/crx",
  "description": "crx is a utility to package Google Chrome extensions via a Node API and the command line",
  "version": "5.1.0",
  "license": "MIT",
  "contributors": [
    "Jed Schmidt <tr@nslator.jp> (http://jed.is)"
  ],
  "homepage": "https://github.com/Hibi-10000/crx",
  "repository": {
    "type": "git",
    "url": "git://github.com/Hibi-10000/crx.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "crx": "dist/cli.js"
  },
  "engines": {
    "node": "^18.20 || >=20.10"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "eslint --fix .",
    "test": "node --experimental-test-coverage --test-coverage-exclude=src/crx3.pb.js --test ./test/index.test.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^14.0.3",
    "pbf": "^4.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=10.16",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/node": "^24.10.13",
    "adm-zip": "^0.5.16",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
