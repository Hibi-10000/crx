{
  "author": "Jed Schmidt <tr@nslator.jp> (http://jed.is)",
  "name": "crx",
  "description": "crx is a utility to package Google Chrome extensions via a Node API and the command line",
  "version": "5.0.1",
  "license": "MIT",
  "homepage": "https://github.com/oncletom/crx",
  "repository": {
    "type": "git",
    "url": "git://github.com/oncletom/crx.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "crx": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "eslint --fix .",
    "test": "node --experimental-test-coverage --test-coverage-exclude=src/crx3.pb.js --test ./test/index.test.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^14.0.2",
    "pbf": "^4.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/node": "^24.10.1",
    "@types/tape": "^5.8.1",
    "adm-zip": "^0.4.13",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "tsdown": "^0.16.5",
    "typescript": "^5.9.3"
  }
}
