{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    //"declaration": true,
    //"isolatedDeclarations": true,
    //"skipLibCheck": true,
  },
  "exclude": [
    "dist",
  ],
}
